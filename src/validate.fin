// SPDX-License-Identifier: MIT
// fin-validate v0.1.0 — input validation for Fin.
//
// Schema-driven validation of untrusted string input (forms, query params,
// config values): required checks, types (string/int/float/bool/email),
// length and numeric ranges, allowed-value lists, and custom validators.
// Nested data is validated through dotted field names ("address.city").
//
// Errors are values, never blame: every problem is reported as a
// ValidationError with a human-readable message.
//
// STATUS: written against docs/agent-guide.md (Fin v0.4.0). UNVERIFIED — no
// finc binary was available in this environment, so nothing below has been
// type-checked or executed yet. See README.md "Verification status".

#[stdimport] %{
import { Collection } from collection::std;
import { to_chars, from_chars, concat, parse_int } from strings::std;
}%

namespace fin {

// strcmp, bound locally (same pattern as lib/std/testing.fin) so the only
// strings::std functions we rely on are to_chars/from_chars/concat/parse_int.
#[llvm_name="strcmp"]
@define valid_strcmp(a: string, b: string) <int>;

priv fun str_eq(a: string, b: string) <bool> {
    return valid_strcmp(a, b) == 0;
}

// --- public types ---

enum FieldType { String, Int, Float, Bool, Email }

struct Field {
    name <string>,
    required <bool>,
    ftype <FieldType>,
    min_len <int>,
    max_len <int>,
    has_min <bool>,
    min_val <float>,
    has_max <bool>,
    max_val <float>,
    allowed <&Collection<string>>,
    has_custom <bool>,
    custom <fn(string) -> bool>,
    custom_msg <string>,
}

struct Schema {
    fields <&Collection<Field>>,
}

struct InputValue {
    key <string>,
    value <string>,
}

struct ValidationError {
    field <string>,
    message <string>,
}

struct ValidationResult {
    ok <bool>,
    errors <&Collection<ValidationError>>,
}

// --- private parse helpers ---

struct IntParse { ok <bool>, value <int>, }
struct FloatParse { ok <bool>, value <float>, }
struct Lookup { found <bool>, value <string>, }

priv fun is_digit(c: char) <bool> {
    return c >= '0' && c <= '9';
}

// Well-formed 32-bit decimal integer, no abort on bad input (parse_int
// blames, so it is only called after this check passes).
priv fun try_parse_int(s: string) <IntParse> {
    let cs <[char]> = to_chars(s);
    let n <int> = cs.length - 1;
    let neg <bool> = false;
    let start <int> = 0;
    if (n > 0 && cs[0] == '-') {
        neg = true;
        start = 1;
    }
    if (start == n) {
        delete cs;
        return IntParse{ok: false, value: 0};
    }
    for (let i <int> = start; i < n; i++) {
        if (!is_digit(cs[i])) {
            delete cs;
            return IntParse{ok: false, value: 0};
        }
    }
    let digits <int> = n - start;
    if (digits > 10) {
        delete cs;
        return IntParse{ok: false, value: 0};
    }
    if (digits == 10) {
        // Same length as the bound, so lexicographic order is numeric order.
        let bound <string> = "2147483647";
        if (neg) { bound = "2147483648"; }
        let bc <[char]> = to_chars(bound);
        let over <bool> = false;
        let under <bool> = false;
        for (let i <int> = 0; i < 10; i++) {
            if (!over && !under) {
                if (cs[start + i] > bc[i]) { over = true; }
                if (cs[start + i] < bc[i]) { under = true; }
            }
        }
        delete bc;
        if (over) {
            delete cs;
            return IntParse{ok: false, value: 0};
        }
    }
    let v <int> = parse_int(s);
    delete cs;
    return IntParse{ok: true, value: v};
}

// [-]digits[.digits], at least one digit. No exponents in v0.1.0.
priv fun try_parse_float(s: string) <FloatParse> {
    let cs <[char]> = to_chars(s);
    let n <int> = cs.length - 1;
    let neg <bool> = false;
    let i <int> = 0;
    if (n > 0 && cs[0] == '-') {
        neg = true;
        i = 1;
    }
    let seen_digit <bool> = false;
    let seen_dot <bool> = false;
    for (let j <int> = i; j < n; j++) {
        if (cs[j] == '.') {
            if (seen_dot) {
                delete cs;
                return FloatParse{ok: false, value: 0.0};
            }
            seen_dot = true;
        } else if (is_digit(cs[j])) {
            seen_digit = true;
        } else {
            delete cs;
            return FloatParse{ok: false, value: 0.0};
        }
    }
    if (!seen_digit) {
        delete cs;
        return FloatParse{ok: false, value: 0.0};
    }
    let v <float> = 0.0;
    let j <int> = i;
    while (j < n && cs[j] != '.') {
        v = v * 10.0 + cast<float>(cast<int>(cs[j]) - cast<int>('0'));
        j++;
    }
    if (j < n && cs[j] == '.') {
        j++;
        let div <float> = 1.0;
        while (j < n) {
            v = v * 10.0 + cast<float>(cast<int>(cs[j]) - cast<int>('0'));
            div = div * 10.0;
            j++;
        }
        v = v / div;
    }
    if (neg) { v = 0.0 - v; }
    delete cs;
    return FloatParse{ok: true, value: v};
}

priv fun lookup(input: &Collection<InputValue>, key: string) <Lookup> {
    let n <int> = input.len();
    for (let i <int> = 0; i < n; i++) {
        let kv <InputValue> = input.get(i);
        if (str_eq(kv.key, key)) {
            return Lookup{found: true, value: kv.value};
        }
    }
    return Lookup{found: false, value: ""};
}

priv fun email_local_char(c: char) <bool> {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c)) { return true; }
    return c == '.' || c == '_' || c == '%' || c == '+' || c == '-';
}

priv fun email_domain_char(c: char) <bool> {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c)) { return true; }
    return c == '.' || c == '-';
}

// Practical (not RFC-5322-complete) email check: one @, dot in domain,
// valid characters, TLD of at least 2 chars.
priv fun valid_email(s: string) <bool> {
    let cs <[char]> = to_chars(s);
    let n <int> = cs.length - 1;
    let at <int> = -1;
    for (let i <int> = 0; i < n; i++) {
        if (cs[i] == '@') {
            if (at != -1) {
                delete cs;
                return false;
            }
            at = i;
        }
        if (cs[i] == ' ') {
            delete cs;
            return false;
        }
    }
    if (at <= 0 || at == n - 1) {
        delete cs;
        return false;
    }
    let dot <int> = -1;
    for (let i <int> = at + 1; i < n; i++) {
        if (cs[i] == '.') { dot = i; }
    }
    if (dot == -1 || dot == at + 1 || dot == n - 1 || n - dot - 1 < 2) {
        delete cs;
        return false;
    }
    for (let i <int> = 0; i < at; i++) {
        if (!email_local_char(cs[i])) {
            delete cs;
            return false;
        }
    }
    for (let i <int> = at + 1; i < n; i++) {
        if (!email_domain_char(cs[i])) {
            delete cs;
            return false;
        }
    }
    delete cs;
    return true;
}

priv fun field_msg(f: &Field, tail: string) <string> {
    return concat(concat(concat("field '", f.name), "' "), tail);
}

priv fun push_error(errs: &Collection<ValidationError>, f: &Field, tail: string) <noret> {
    errs.push(ValidationError{field: f.name, message: field_msg(f, tail)});
}

priv fun check_value(f: &Field, value: string, errs: &Collection<ValidationError>) <noret> {
    let vcs <[char]> = to_chars(value);
    let vlen <int> = vcs.length - 1;
    delete vcs;

    if (f.ftype == FieldType::String) {
        if (f.min_len >= 0 && vlen < f.min_len) {
            push_error(errs, f, "is too short");
        }
        if (f.max_len >= 0 && vlen > f.max_len) {
            push_error(errs, f, "is too long");
        }
    }
    if (f.ftype == FieldType::Email) {
        if (!valid_email(value)) {
            push_error(errs, f, "is not a valid email address");
        }
    }
    if (f.ftype == FieldType::Int) {
        let p <IntParse> = try_parse_int(value);
        if (!p.ok) {
            push_error(errs, f, "must be an integer");
        } else {
            let fv <float> = cast<float>(p.value);
            if (f.has_min && fv < f.min_val) { push_error(errs, f, "is below the minimum"); }
            if (f.has_max && fv > f.max_val) { push_error(errs, f, "is above the maximum"); }
        }
    }
    if (f.ftype == FieldType::Float) {
        let p <FloatParse> = try_parse_float(value);
        if (!p.ok) {
            push_error(errs, f, "must be a number");
        } else {
            if (f.has_min && p.value < f.min_val) { push_error(errs, f, "is below the minimum"); }
            if (f.has_max && p.value > f.max_val) { push_error(errs, f, "is above the maximum"); }
        }
    }
    if (f.ftype == FieldType::Bool) {
        if (!str_eq(value, "true") && !str_eq(value, "false") && !str_eq(value, "1") && !str_eq(value, "0")) {
            push_error(errs, f, "must be a boolean (true/false/1/0)");
        }
    }
    if (f.allowed.len() > 0) {
        let ok <bool> = false;
        for (let i <int> = 0; i < f.allowed.len(); i++) {
            if (str_eq(value, f.allowed.get(i))) { ok = true; }
        }
        if (!ok) {
            push_error(errs, f, "is not an allowed value");
        }
    }
    if (f.has_custom) {
        let c <fn(string) -> bool> = f.custom;
        if (!c(value)) {
            errs.push(ValidationError{field: f.name, message: f.custom_msg});
        }
    }
}

// --- public API ---

// Default custom validator (always passes) used for fields without one.
priv fun no_custom(v: string) <bool> {
    return true;
}

// Create an empty schema. Add fields with the add_*_field functions.
#[export]
pub fun new_schema() <Schema> {
    return Schema{fields: new Collection::<Field>{}};
}

#[export]
pub fun add_string_field(s: &Schema, name: string, required: bool, min_len: int, max_len: int) <noret> {
    s.fields.push(Field{name: name, required: required, ftype: FieldType::String,
        min_len: min_len, max_len: max_len,
        has_min: false, min_val: 0.0, has_max: false, max_val: 0.0,
        allowed: new Collection::<string>{},
        has_custom: false, custom: no_custom, custom_msg: ""});
}

#[export]
pub fun add_email_field(s: &Schema, name: string, required: bool) <noret> {
    s.fields.push(Field{name: name, required: required, ftype: FieldType::Email,
        min_len: -1, max_len: -1,
        has_min: false, min_val: 0.0, has_max: false, max_val: 0.0,
        allowed: new Collection::<string>{},
        has_custom: false, custom: no_custom, custom_msg: ""});
}

#[export]
pub fun add_int_field(s: &Schema, name: string, required: bool, has_min: bool, min_v: float, has_max: bool, max_v: float) <noret> {
    s.fields.push(Field{name: name, required: required, ftype: FieldType::Int,
        min_len: -1, max_len: -1,
        has_min: has_min, min_val: min_v, has_max: has_max, max_val: max_v,
        allowed: new Collection::<string>{},
        has_custom: false, custom: no_custom, custom_msg: ""});
}

#[export]
pub fun add_float_field(s: &Schema, name: string, required: bool, has_min: bool, min_v: float, has_max: bool, max_v: float) <noret> {
    s.fields.push(Field{name: name, required: required, ftype: FieldType::Float,
        min_len: -1, max_len: -1,
        has_min: has_min, min_val: min_v, has_max: has_max, max_val: max_v,
        allowed: new Collection::<string>{},
        has_custom: false, custom: no_custom, custom_msg: ""});
}

#[export]
pub fun add_bool_field(s: &Schema, name: string, required: bool) <noret> {
    s.fields.push(Field{name: name, required: required, ftype: FieldType::Bool,
        min_len: -1, max_len: -1,
        has_min: false, min_val: 0.0, has_max: false, max_val: 0.0,
        allowed: new Collection::<string>{},
        has_custom: false, custom: no_custom, custom_msg: ""});
}

#[export]
pub fun add_one_of_field(s: &Schema, name: string, required: bool, allowed: &Collection<string>) <noret> {
    s.fields.push(Field{name: name, required: required, ftype: FieldType::String,
        min_len: -1, max_len: -1,
        has_min: false, min_val: 0.0, has_max: false, max_val: 0.0,
        allowed: allowed,
        has_custom: false, custom: no_custom, custom_msg: ""});
}

// Custom validator: check receives the raw string value and returns true
// when it passes. Lambdas cannot capture locals — write check as a pure
// function of the value, e.g. (s: string) <bool> => { ... }.
#[export]
pub fun add_custom_field(s: &Schema, name: string, required: bool, check: fn(string) -> bool, message: string) <noret> {
    s.fields.push(Field{name: name, required: required, ftype: FieldType::String,
        min_len: -1, max_len: -1,
        has_min: false, min_val: 0.0, has_max: false, max_val: 0.0,
        allowed: new Collection::<string>{},
        has_custom: true, custom: check, custom_msg: message});
}

// Build an input set: new_input(), then input_set(input, key, value) per pair.
// Dotted keys ("address.city") validate against dotted field names.
#[export]
pub fun new_input() <&Collection<InputValue>> {
    return new Collection::<InputValue>{};
}

#[export]
pub fun input_set(input: &Collection<InputValue>, key: string, value: string) <noret> {
    input.push(InputValue{key: key, value: value});
}

// Validate input against the schema. Never aborts: problems come back as
// ValidationError values in the result.
#[export]
pub fun schema_check(s: &Schema, input: &Collection<InputValue>) <ValidationResult> {
    let errs <&Collection<ValidationError>> = new Collection::<ValidationError>{};
    let n <int> = s.fields.len();
    for (let i <int> = 0; i < n; i++) {
        let f <Field> = s.fields.get(i);
        let lu <Lookup> = lookup(input, f.name);
        if (!lu.found && f.required) {
            push_error(errs, &f, "is required");
        }
        if (lu.found) {
            let vcs <[char]> = to_chars(lu.value);
            let empty <bool> = (vcs.length - 1) == 0;
            delete vcs;
            if (empty && f.required) {
                push_error(errs, &f, "is required");
            } else if (!empty) {
                check_value(&f, lu.value, errs);
            }
        }
    }
    return ValidationResult{ok: errs.len() == 0, errors: errs};
}

#[export]
pub fun error_count(r: &ValidationResult) <int> {
    return r.errors.len();
}

#[export]
pub fun error_at(r: &ValidationResult, i: int) <ValidationError> {
    return r.errors.get(i);
}

}
