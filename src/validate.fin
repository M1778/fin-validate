// SPDX-License-Identifier: MIT
// Schema-driven validation of borrowed NUL-terminated input strings.
// Invalid values return errors; caller programming errors (invalid error indices,
// dangling pointers, aborting custom callbacks) are not recoverable here.

#[stdimport] %{
import { Collection } from collection::std;
import { to_chars, concat, free_str, len, is_empty } from strings::std;
}%

namespace fin {

#[llvm_name="strcmp"]
@define valid_strcmp(a: string, b: string) <int>;

priv fun str_eq(a: string, b: string) <bool> {
    return valid_strcmp(a, b) == 0;
}

// Type codes: 0=string, 1=int, 2=float, 3=bool, 4=email.
struct Field {
    name <string>,
    required <bool>,
    ftype <int>,
    min_len <int>,
    max_len <int>,
    has_min <bool>,
    min_val <float>,
    has_max <bool>,
    max_val <float>,
    exact_int <bool>,
    min_int <int>,
    max_int <int>,
    has_allowed <bool>,
    allowed <&Collection<string>>,
    has_custom <bool>,
    custom <fn(string) -> bool>,
    custom_msg <string>,
}

// Owning handles: do not copy after construction. Use the named APIs, not the
// public backing fields. Manual disposal avoids implicit double-free on copies.
#[export]
pub struct Schema {
    pub:
        fields <[&Field]>,
        field_count <int>,
}

#[export]
pub struct InputValue {
    pub:
        key <string>,
        value <string>,
}

#[export]
pub struct ValidationError {
    pub:
        field <string>,
        message <string>,
        owns_message <bool>,
}

#[export]
pub struct ValidationResult {
    pub:
        ok <bool>,
        errors <[&ValidationError]>,
        error_size <int>,
}

struct IntParse { ok <bool>, value <int>, }
struct FloatParse { ok <bool>, value <float>, }
struct Lookup { found <bool>, value <string>, }

priv fun is_digit(c: char) <bool> {
    return c >= '0' && c <= '9';
}

// Accumulate only after checking the next digit. No aborting stdlib parser,
// no signed overflow, and arbitrary leading zeroes do not consume range.
priv fun try_parse_int(s: string) <IntParse> {
    let cs <[char]> = to_chars(s);
    let n <int> = cs.length - 1;
    let neg <bool> = false;
    let start <int> = 0;
    if (n > 0 && cs[0] == '-') {
        neg = true;
        start = 1;
    }
    if (start == n) {
        delete cs;
        return IntParse{ok: false, value: 0};
    }
    let limit <long> = cast<long>(2147483647);
    if (neg) { limit += cast<long>(1); }
    let acc <long> = cast<long>(0);
    for (let i <int> = start; i < n; i++) {
        if (!is_digit(cs[i])) {
            delete cs;
            return IntParse{ok: false, value: 0};
        }
        let digit <long> = cast<long>(cast<int>(cs[i]) - cast<int>('0'));
        if (acc > (limit - digit) / cast<long>(10)) {
            delete cs;
            return IntParse{ok: false, value: 0};
        }
        acc = acc * cast<long>(10) + digit;
    }
    delete cs;
    if (neg) { acc = -acc; }
    return IntParse{ok: true, value: cast<int>(acc)};
}

// Decimal only, with an optional minus and at most one dot; at least one
// digit is required. Retains support for .5 and 1. (no plus or exponent).
// Fractional place values decrease: a long fraction never overflows a
// numerator/divisor pair. Double intermediates reduce premature rounding.
priv fun try_parse_float(s: string) <FloatParse> {
    let cs <[char]> = to_chars(s);
    let n <int> = cs.length - 1;
    let neg <bool> = false;
    let start <int> = 0;
    if (n > 0 && cs[0] == '-') {
        neg = true;
        start = 1;
    }
    let seen_digit <bool> = false;
    let seen_dot <bool> = false;
    let v <double> = cast<double>(0.0);
    let place <double> = cast<double>(1.0);
    // Exact largest finite binary32 value.
    let max_float <float> = 340282346638528859811704183484516925440.0;
    for (let i <int> = start; i < n; i++) {
        if (cs[i] == '.') {
            if (seen_dot) {
                delete cs;
                return FloatParse{ok: false, value: 0.0};
            }
            seen_dot = true;
        } else if (is_digit(cs[i])) {
            seen_digit = true;
            let digit <double> = cast<double>(cast<int>(cs[i]) - cast<int>('0'));
            if (seen_dot) {
                place = place / cast<double>(10.0);
                v = v + digit * place;
            } else {
                // Keep intermediates finite even for enormous integer strings.
                if (v > cast<double>(max_float)) {
                    delete cs;
                    return FloatParse{ok: false, value: 0.0};
                }
                v = v * cast<double>(10.0) + digit;
            }
        } else {
            delete cs;
            return FloatParse{ok: false, value: 0.0};
        }
    }
    delete cs;
    if (!seen_digit) { return FloatParse{ok: false, value: 0.0}; }
    if (neg) { v = -v; }
    let result <float> = cast<float>(v);
    // Ordered comparisons reject both infinities and NaN, with or without
    // schema range bounds. Tiny fractions may round/underflow to zero.
    if (!(result >= -max_float && result <= max_float)) {
        return FloatParse{ok: false, value: 0.0};
    }
    return FloatParse{ok: true, value: result};
}

priv fun lookup(input: &Collection<&InputValue>, key: string) <Lookup> {
    let n <int> = input.len();
    for (let i <int> = 0; i < n; i++) {
        let kv <&InputValue> = input.get(i);
        if (str_eq(kv.key, key)) {
            return Lookup{found: true, value: kv.value};
        }
    }
    return Lookup{found: false, value: ""};
}

priv fun email_local_char(c: char) <bool> {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c)) { return true; }
    return c == '.' || c == '_' || c == '%' || c == '+' || c == '-';
}

priv fun email_domain_char(c: char) <bool> {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c)) { return true; }
    return c == '.' || c == '-';
}

// Practical (not RFC-5322-complete) email check: one @, dot in domain,
// valid characters, TLD of at least 2 chars.
priv fun valid_email(s: string) <bool> {
    let cs <[char]> = to_chars(s);
    let n <int> = cs.length - 1;
    let at <int> = -1;
    for (let i <int> = 0; i < n; i++) {
        if (cs[i] == '@') {
            if (at != -1) {
                delete cs;
                return false;
            }
            at = i;
        }
        if (cs[i] == ' ') {
            delete cs;
            return false;
        }
    }
    if (at <= 0 || at == n - 1) {
        delete cs;
        return false;
    }
    let dot <int> = -1;
    for (let i <int> = at + 1; i < n; i++) {
        if (cs[i] == '.') { dot = i; }
    }
    if (dot == -1 || dot == at + 1 || dot == n - 1 || n - dot - 1 < 2) {
        delete cs;
        return false;
    }
    for (let i <int> = 0; i < at; i++) {
        if (!email_local_char(cs[i])) {
            delete cs;
            return false;
        }
    }
    for (let i <int> = at + 1; i < n; i++) {
        if (!email_domain_char(cs[i])) {
            delete cs;
            return false;
        }
    }
    delete cs;
    return true;
}

priv fun field_msg(f: &Field, tail: string) <string> {
    let prefix <string> = concat("field '", f.name);
    let subject <string> = concat(prefix, "' ");
    free_str(prefix);
    let message <string> = concat(subject, tail);
    free_str(subject);
    return message;
}

priv fun append_error(r: &ValidationResult, error: &ValidationError) <noret> {
    if (r.errors == null || r.error_size == r.errors.length) {
        let capacity <int> = 4;
        if (r.errors != null) { capacity = r.errors.length * 2; }
        let grown <[&ValidationError]> = new [&ValidationError, capacity]{};
        for (let i <int> = 0; i < r.error_size; i++) { grown[i] = r.errors[i]; }
        if (r.errors != null) { delete r.errors; }
        r.errors = grown;
    }
    r.errors[r.error_size] = error;
    r.error_size++;
    r.ok = false;
}

priv fun push_error(r: &ValidationResult, f: &Field, tail: string) <noret> {
    append_error(r, new ValidationError{field: f.name, message: field_msg(f, tail), owns_message: true});
}

priv fun check_value(f: &Field, value: string, r: &ValidationResult) <noret> {
    if (f.ftype == 0) {
        let vlen <int> = len(value);
        if (f.min_len >= 0 && vlen < f.min_len) { push_error(r, f, "is too short"); }
        if (f.max_len >= 0 && vlen > f.max_len) { push_error(r, f, "is too long"); }
    }
    if (f.ftype == 4 && !valid_email(value)) {
        push_error(r, f, "is not a valid email address");
    }
    if (f.ftype == 1) {
        let p <IntParse> = try_parse_int(value);
        if (!p.ok) {
            push_error(r, f, "must be an integer");
        } else if (f.exact_int) {
            if (f.has_min && p.value < f.min_int) { push_error(r, f, "is below the minimum"); }
            if (f.has_max && p.value > f.max_int) { push_error(r, f, "is above the maximum"); }
        } else {
            // Promote both operands: every int32 and binary32 bound is exact
            // in double. Only the caller's float bound may already be rounded.
            let fv <double> = cast<double>(p.value);
            if (f.has_min && fv < cast<double>(f.min_val)) { push_error(r, f, "is below the minimum"); }
            if (f.has_max && fv > cast<double>(f.max_val)) { push_error(r, f, "is above the maximum"); }
        }
    }
    if (f.ftype == 2) {
        let p <FloatParse> = try_parse_float(value);
        if (!p.ok) {
            push_error(r, f, "must be a number");
        } else {
            if (f.has_min && p.value < f.min_val) { push_error(r, f, "is below the minimum"); }
            if (f.has_max && p.value > f.max_val) { push_error(r, f, "is above the maximum"); }
        }
    }
    if (f.ftype == 3) {
        if (!str_eq(value, "true") && !str_eq(value, "false") && !str_eq(value, "1") && !str_eq(value, "0")) {
            push_error(r, f, "must be a boolean (true/false/1/0)");
        }
    }
    if (f.has_allowed) {
        let ok <bool> = false;
        // A null or empty configured allowlist permits no nonempty value.
        if (f.allowed != null) {
            for (let i <int> = 0; i < f.allowed.len(); i++) {
                if (str_eq(value, f.allowed.get(i))) { ok = true; break; }
            }
        }
        if (!ok) { push_error(r, f, "is not an allowed value"); }
    }
    if (f.has_custom) {
        let c <fn(string) -> bool> = f.custom;
        if (!c(value)) {
            append_error(r, new ValidationError{field: f.name, message: f.custom_msg, owns_message: false});
        }
    }
}

// Collections have a private buffer and no release API in the frozen stdlib.
// Schema/result storage therefore owns arrays directly, not Collections.
#[export]
pub fun new_schema() <Schema> {
    return Schema{};
}

priv fun append_field(s: &Schema, field: &Field) <noret> {
    if (s.fields == null || s.field_count == s.fields.length) {
        let capacity <int> = 4;
        if (s.fields != null) { capacity = s.fields.length * 2; }
        let grown <[&Field]> = new [&Field, capacity]{};
        for (let i <int> = 0; i < s.field_count; i++) { grown[i] = s.fields[i]; }
        if (s.fields != null) { delete s.fields; }
        s.fields = grown;
    }
    s.fields[s.field_count] = field;
    s.field_count++;
}

// Frees field objects, retaining capacity. Names, custom messages and allowed
// lists are borrowed and are never freed or mutated by schema cleanup.
#[export]
pub fun schema_clear(s: &Schema) <noret> {
    for (let i <int> = 0; i < s.field_count; i++) {
        delete s.fields[i];
        s.fields[i] = null;
    }
    s.field_count = 0;
}

#[export]
pub fun schema_dispose(s: &Schema) <noret> {
    schema_clear(s);
    if (s.fields != null) { delete s.fields; }
    let empty <Schema> = Schema{};
    s.fields = empty.fields;
}

#[export]
pub fun add_string_field(s: &Schema, name: string, required: bool, min_len: int, max_len: int) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 0,
        min_len: min_len, max_len: max_len});
}

#[export]
pub fun add_email_field(s: &Schema, name: string, required: bool) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 4,
        min_len: -1, max_len: -1});
}

// Compatibility API: binary32 bound parameters, exact promoted comparisons.
#[export]
pub fun add_int_field(s: &Schema, name: string, required: bool, has_min: bool, min_v: float, has_max: bool, max_v: float) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 1,
        min_len: -1, max_len: -1,
        has_min: has_min, min_val: min_v, has_max: has_max, max_val: max_v});
}

// Exact inclusive int32 bounds, including both endpoints. No float conversion.
#[export]
pub fun add_int_range_field(s: &Schema, name: string, required: bool, has_min: bool, min_v: int, has_max: bool, max_v: int) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 1,
        min_len: -1, max_len: -1, exact_int: true,
        has_min: has_min, min_int: min_v, has_max: has_max, max_int: max_v});
}

#[export]
pub fun add_float_field(s: &Schema, name: string, required: bool, has_min: bool, min_v: float, has_max: bool, max_v: float) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 2,
        min_len: -1, max_len: -1,
        has_min: has_min, min_val: min_v, has_max: has_max, max_val: max_v});
}

#[export]
pub fun add_bool_field(s: &Schema, name: string, required: bool) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 3,
        min_len: -1, max_len: -1});
}

#[export]
pub fun add_one_of_field(s: &Schema, name: string, required: bool, allowed: &Collection<string>) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 0,
        min_len: -1, max_len: -1, has_allowed: true, allowed: allowed});
}

#[export]
pub fun add_custom_field(s: &Schema, name: string, required: bool, check: fn(string) -> bool, message: string) <noret> {
    append_field(s, new Field{name: name, required: required, ftype: 0,
        min_len: -1, max_len: -1, has_custom: true, custom: check, custom_msg: message});
}

#[export]
pub fun new_input() <&Collection<&InputValue>> {
    return new Collection::<&InputValue>{};
}

// Keys and values remain borrowed. Replacement does not free either string.
#[export]
pub fun input_set(input: &Collection<&InputValue>, key: string, value: string) <noret> {
    let n <int> = input.len();
    for (let i <int> = 0; i < n; i++) {
        let kv <&InputValue> = input.get(i);
        if (str_eq(kv.key, key)) { kv.value = value; return; }
    }
    input.push(new InputValue{key: key, value: value});
}

// Free input entries, retain Collection capacity for reuse. The frozen stdlib
// cannot dispose a Collection's private buffer; this does not pretend it can.
#[export]
pub fun input_clear(input: &Collection<&InputValue>) <noret> {
    for (let i <int> = 0; i < input.len(); i++) {
        let entry <&InputValue> = input.get(i);
        delete entry;
    }
    input.clear();
}

#[export]
pub fun new_result() <ValidationResult> {
    return ValidationResult{ok: true};
}

// Error pointers become invalid after clear/check_into/dispose. Only generated
// messages are owned; custom messages and all field names remain borrowed.
#[export]
pub fun result_clear(r: &ValidationResult) <noret> {
    for (let i <int> = 0; i < r.error_size; i++) {
        let error <&ValidationError> = r.errors[i];
        if (error.owns_message) { free_str(error.message); }
        delete error;
        r.errors[i] = null;
    }
    r.error_size = 0;
    r.ok = true;
}

#[export]
pub fun result_dispose(r: &ValidationResult) <noret> {
    result_clear(r);
    if (r.errors != null) { delete r.errors; }
    let empty <ValidationResult> = ValidationResult{};
    r.errors = empty.errors;
}

// Reuses result capacity while replacing all previous errors.
#[export]
pub fun schema_check_into(s: &Schema, input: &Collection<&InputValue>, r: &ValidationResult) <noret> {
    result_clear(r);
    for (let i <int> = 0; i < s.field_count; i++) {
        let f <&Field> = s.fields[i];
        let lu <Lookup> = lookup(input, f.name);
        if (!lu.found && f.required) { push_error(r, f, "is required"); }
        if (lu.found) {
            if (is_empty(lu.value)) {
                if (f.required) { push_error(r, f, "is required"); }
            } else {
                check_value(f, lu.value, r);
            }
        }
    }
}

#[export]
pub fun schema_check(s: &Schema, input: &Collection<&InputValue>) <ValidationResult> {
    let r <ValidationResult> = new_result();
    schema_check_into(s, input, &r);
    return r;
}

#[export]
pub fun error_count(r: &ValidationResult) <int> {
    return r.error_size;
}

#[export]
pub fun error_at(r: &ValidationResult, i: int) <&ValidationError> {
    blame i >= 0 && i < r.error_size, "error index out of bounds";
    return r.errors[i];
}

}
